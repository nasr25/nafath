<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config for the frontend (SPA) site served at domain/.
  Deployed to dist/web.config (Vite copies everything in public/ to the build root).

  Two jobs:
   1. Forward the IAM callback (domain/_IAM/login) into the Laravel backend app
      at domain/backend/_IAM/login. This is an INTERNAL rewrite (not a redirect),
      so IAM's form_post POST body (the id_token) is preserved.
   2. SPA history fallback: serve index.html for client-side routes.

  Assumes the Laravel backend is an IIS application/virtual dir at /backend
  (i.e. domain/backend/... reaches Laravel). If your backend path differs,
  change "backend/_IAM/login" and the "^/backend/" pattern below to match.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. IAM callback (GET or POST) -> Laravel backend app -->
        <rule name="IAM callback to backend" stopProcessing="true">
          <match url="^_IAM/login/?$" />
          <action type="Rewrite" url="backend/_IAM/login" appendQueryString="true" />
        </rule>

        <!-- 2. SPA history fallback (skip real files, the backend app, and the callback) -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/backend/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/_IAM/login" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
