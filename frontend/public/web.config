<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the frontend (SPA) site served at domain/.
  Deployed to dist/web.config (Vite copies public/ to the build root).

  Layout on the server: frontend at domain/, Laravel backend as an IIS
  APPLICATION at domain/backend. IAM calls back to domain/_IAM/login and
  dispatches Single Logout to domain/_IAM/logout — both must reach the backend.

  The two IAM rules below run BEFORE the SPA history fallback and internally
  rewrite (not redirect, so IAM's form_post POST body is preserved) into the
  backend app. If an internal rewrite into the child app does not resolve on
  your IIS, switch those actions to an ARR reverse proxy (see README/notes).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- IAM login callback (GET or POST) -> backend app -->
        <rule name="IAM login to backend" stopProcessing="true">
          <match url="^_IAM/login/?$" />
          <action type="Rewrite" url="backend/_IAM/login" appendQueryString="true" />
        </rule>

        <!-- IAM Single Logout dispatch (?slo=false) -> backend app -->
        <rule name="IAM logout to backend" stopProcessing="true">
          <match url="^_IAM/logout/?$" />
          <action type="Rewrite" url="backend/_IAM/logout" appendQueryString="true" />
        </rule>

        <!-- SPA history fallback (skip real files, the backend app, and /_IAM) -->
        <rule name="Handle History Mode" stopProcessing="true">
          <match url="^(?!.*\.\w+$).*$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(backend|_IAM)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
