<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG frontend web.config — routes /_IAM/login to the SPA (not the backend)
  so the in-app 🐞 Debug panel renders and shows what the browser received.

  Use temporarily to diagnose routing: swap the site's web.config for this one,
  then hit https://<domain>/_IAM/login (or open it after an IAM redirect).

  IMPORTANT: this only catches GET / fragment redirects. A form_post (POST) to a
  static SPA still returns 405 — which itself confirms IAM is using form_post,
  in which case revert to the normal public/web.config (backend handles it).

  Revert to public/web.config for normal operation once done.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- Keep logout going to the backend; only login is sent to the SPA for debug. -->
        <rule name="IAM logout to backend" stopProcessing="true">
          <match url="^_IAM/logout/?$" />
          <action type="Rewrite" url="backend/_IAM/logout" appendQueryString="true" />
        </rule>

        <!-- Serve the SPA (index.html) for /_IAM/login so the debug panel shows. -->
        <rule name="IAM login to SPA (debug)" stopProcessing="true">
          <match url="^_IAM/login/?$" />
          <action type="Rewrite" url="/" appendQueryString="true" />
        </rule>

        <!-- SPA history fallback (skip real files and the backend app). -->
        <rule name="Handle History Mode" stopProcessing="true">
          <match url="^(?!.*\.\w+$).*$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(backend)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
