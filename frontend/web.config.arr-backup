<?xml version="1.0" encoding="utf-8"?>
<!--
  ARR reverse-proxy frontend web.config.

  USE THIS when the normal internal-rewrite config leaves domain/_IAM/... at 404
  while the direct backend URL domain/backend/_IAM/... returns 200 — i.e. the
  parent site cannot internally rewrite into the /backend child application
  (confirmed by: /backend/_IAM/ping = 200 but /_IAM/ping = 404).

  A reverse proxy makes a fresh HTTP request to the backend, which IIS routes
  correctly into the child app. It also preserves the POST body (form_post).

  PREREQUISITES (one-time, on the server):
    1. Install the IIS module "Application Request Routing" (ARR) — via Web
       Platform Installer, or download "ARR 3.0" from Microsoft.
    2. IIS Manager -> select the SERVER node (top-left) -> open
       "Application Request Routing Cache" -> in the right "Actions" pane click
       "Server Proxy Settings..." -> tick "Enable proxy" -> Apply.

  Proxy target uses {HTTP_HOST} so it reuses the site's own hostname + TLS cert.
  If the backend is on a different host/port, hard-code it in the three actions.

  TEST after applying:  curl.exe -i "https://<domain>/_IAM/ping"   (expect 200)
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- Diagnostic ping -> proxied to backend app -->
        <rule name="IAM ping to backend (proxy)" stopProcessing="true">
          <match url="^_IAM/ping/?$" />
          <action type="Rewrite" url="https://{HTTP_HOST}/backend/_IAM/ping" appendQueryString="true" />
        </rule>

        <!-- IAM login callback (GET or POST) -> proxied to backend app -->
        <rule name="IAM login to backend (proxy)" stopProcessing="true">
          <match url="^_IAM/login/?$" />
          <action type="Rewrite" url="https://{HTTP_HOST}/backend/_IAM/login" appendQueryString="true" />
        </rule>

        <!-- IAM Single Logout dispatch (?slo=false) -> proxied to backend app -->
        <rule name="IAM logout to backend (proxy)" stopProcessing="true">
          <match url="^_IAM/logout/?$" />
          <action type="Rewrite" url="https://{HTTP_HOST}/backend/_IAM/logout" appendQueryString="true" />
        </rule>

        <!-- SPA history fallback (skip real files, the backend app, and /_IAM) -->
        <rule name="Handle History Mode" stopProcessing="true">
          <match url="^(?!.*\.\w+$).*$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(backend|_IAM)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
