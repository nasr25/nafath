# Frontend (Vite) configuration.
# Copy this file to `.env.production` (used by `npm run build`) or `.env` and
# adjust the values for the machine you build on. Only VITE_* vars are exposed
# to the browser bundle. None of these are secrets — they end up in the built JS.

# Base URL of the Laravel backend API.
#   - Leave EMPTY when the same web server that serves the frontend also serves
#     /api (e.g. it reverse-proxies /api/* to Laravel). This is the usual setup
#     on the whitelisted host: https://mydomain.com serves the SPA and /api.
#   - Set an absolute URL if the backend lives on a different origin, e.g.
#     VITE_API_BASE_URL=https://api.mydomain.com
# In local dev you can leave this empty; the Vite proxy forwards /api to :8000.
VITE_API_BASE_URL=

# Path IAM redirects back to. MUST match the path of the redirect_uri you
# registered with IAM (and NAFATH_REDIRECT_URI in the backend .env).
VITE_CALLBACK_PATH=/_IAM/login
