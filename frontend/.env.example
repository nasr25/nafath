# Frontend (Vite) configuration.
# Copy to `.env.production` (used by `npm run build`). Only VITE_* vars reach
# the browser bundle; none are secrets.
#
# Layout: Laravel is the IIS site root; this SPA is an application under it at
# /app (see `base` in vite.config.js). The backend is therefore same-origin.

# Base URL of the Laravel backend.
#   - Leave EMPTY (recommended) since the backend is the same-origin site root;
#     API calls go to /api and /nafath.
#   - Set an absolute URL only if the backend is on a different origin.
VITE_API_BASE_URL=
