# Used automatically by `npm run build`. Values are baked into the bundle
# (not secrets). Matches the IIS layout: frontend at domain/, Laravel at
# domain/backend, IAM callback rewritten from domain/_IAM/login into the backend.

# Backend lives under /backend, so the SPA's API calls go to domain/backend/api/...
VITE_API_BASE_URL=/backend

# Path IAM redirects to (matches the registered redirect_uri path).
VITE_CALLBACK_PATH=/_IAM/login
